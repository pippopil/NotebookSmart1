<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background">

    <!-- Left pane: Current Month Calendar Bitmap with workload colors -->
    <ImageView
        android:id="@+id/widget_calendar_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:scaleType="fitCenter"
        android:contentDescription="Календарь месяца" />

    <!-- Thin vertical divider -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="#E7DFD5" />

    <!-- Right pane: Nearest Event, Reminder & Task -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📓 NotebookSmart"
            android:textColor="#92400E"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- 1. Ближайшее событие -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 СОБЫТИЕ"
            android:textColor="#0369A1"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nearest_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нет ближайших"
            android:textColor="#1C1917"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_nearest_event_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Откройте для добавления"
            android:textColor="#78716C"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- 2. Напоминание -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 НАПОМИНАНИЕ"
            android:textColor="#B45309"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nearest_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Не назначено"
            android:textColor="#1C1917"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_nearest_reminder_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#78716C"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- 3. Задание -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ ЗАДАНИЕ"
            android:textColor="#047857"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nearest_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Все выполнены"
            android:textColor="#1C1917"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_nearest_task_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#78716C"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
